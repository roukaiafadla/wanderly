# Copy this to .env for local overrides. None of these are required to run
# the app locally — without them it uses a local SQLite file and port 3000.

PORT=3000

# Leave both blank to use a local SQLite file at server/data/wanderly.db.
# Fill both in to point at a Turso (libSQL) database instead — needed on
# hosts with an ephemeral filesystem (e.g. Render's free tier), since the
# local file would otherwise be wiped on every redeploy/restart.
# Get these from https://turso.tech after `turso db create wanderly`.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# How long an admin login session lasts, in milliseconds. Default: 12 hours.
SESSION_TTL_MS=43200000
